# Copy to terraform.tfvars and edit. Only project_id is required.
project_id  = "my-pipewright-dev"
region      = "us-central1"
environment = "dev"

# App teams. Each gets a runner service account, a BigQuery dataset and a landing prefix under incoming/.
tenants = {
  demo = {
    members = ["user:you@example.com"]   # may start runs and read retrain cases
    # agent_identity   = true                    # a metadata-only identity for coding agents (pipewright mcp)
    # feature_datasets = ["my-project.features"] # feature tables the team may read (data.features_from)
  }
}

# People or CI identities who release use cases (project owners already can).
operators = ["user:you@example.com"]

# Approver groups for retrain decisions. Use cases name them in retraining.approvals.required.
approver_groups = {
  ml-leads = { members = ["user:you@example.com"], description = "ML leads" }
}

policies = {
  promote_model = "manual"
  deploy_model  = "manual"
  # Pipewright phase 6: what runs is what was approved. Deploy and promote refuse a version that is not the one
  # approved unless mode = "warn". A lock keeps the approved model files from being overwritten (it turns on object
  # retention for the artifacts bucket: check the plan). inference: "warn" or "refuse" a scoring run whose default
  # version has no approval.
  # integrity = { mode = "refuse", lock = { days = 30, mode = "unlocked" }, inference = "warn" }
  # Pipewright 1.4.1, inside integrity (defaults shown): pin = "on", watch = "off", watch_every = "1h",
  # lock.renew = true, lock.rollback_days = <lock.days>, until = null, reason = null,
  # features = { check = "off", built_tables = false, record_reads = false, fingerprint_rows = false, snapshot_days = 0 }
}

# Pipewright 1.4.1 (integrity.tf), defaults shown:
# renewer                 = true   # the renewer identity and its Cloud Run job (with lock.days and lock.renew)
# renewer_schedule        = false  # run it daily: after one run by hand passes
# data_write_logs         = false  # Cloud Storage DATA_WRITE audit logs (who wrote a file)
# audit_retention_days    = 0      # route audit entries to a log bucket kept this long
# audit_log_bucket_locked = true   # its retention cannot be shortened
# platform_alert_emails   = []     # the environment's integrity alerts

# Pipewright phase 6: each team's runner writes only under its own pipeline root (recommended for shared projects).
# isolate_tenant_artifacts = true

# Second apply: the launcher image printed by scripts/publish_launcher.sh.
# launcher_image = "us-central1-docker.pkg.dev/my-pipewright-dev/pw-images/pipewright-launcher@sha256:..."

# Optional (Pipewright 1.2.0): a CI identity for GitHub Actions in one repository; it becomes an operator.
# github = { repository = "your-org/your-mlops-repo" }

# Optional: in an environment another one promotes from, the identities that promote (the destination's CI account).
# promotion_readers = ["serviceAccount:pw-github-ci@my-pipewright-prod.iam.gserviceaccount.com"]

# Defaults: every lifecycle event kept in BigQuery; untagged images deleted after 30 days.
# event_log            = true
# image_retention_days = 30
